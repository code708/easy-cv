---
import '../styles/continuous-page.layout.css';

interface Props {
	title: string;
	paddingLeft?: string;
	paddingRight?: string;
}

const { title, paddingLeft = '0', paddingRight = '0' } = Astro.props;
---

<html>
	<head lang="en">
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	</head>
	<body>
		<div class="continuous-page">
			<slot />
		</div>
	</body>
</html>
